generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  COD
  BKASH
  NAGAD
  ONLINE
}

model User {
  id           String          @id @default(cuid())
  email        String?         @unique
  phone        String          @unique
  passwordHash String
  role         UserRole        @default(CUSTOMER)
  profile      CustomerProfile?
  addresses    Address[]
  orders       Order[]
  notifications Notification[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model CustomerProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  fullName  String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  label     String?
  area      String
  address   String
  phone     String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders    Order[]
  createdAt DateTime @default(now())
}

model Category {
  id        String    @id @default(cuid())
  nameBn    String
  nameEn    String?
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id             String            @id @default(cuid())
  nameBn         String
  nameEn         String?
  slug           String            @unique
  descriptionBn  String?
  imageUrl       String
  categoryId     String
  category       Category          @relation(fields: [categoryId], references: [id])
  variants       ProductVariant[]
  featured       Boolean           @default(false)
  bestSeller     Boolean           @default(false)
  active         Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

model ProductVariant {
  id             String      @id @default(cuid())
  productId      String
  product        Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  labelBn        String
  grams          Int
  price          Int
  discountPrice  Int?
  stockGrams     Int
  minOrderGrams  Int          @default(500)
  active         Boolean      @default(true)
  orderItems     OrderItem[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Order {
  id             String         @id @default(cuid())
  orderNumber    String         @unique
  userId         String
  addressId      String?
  customerName   String
  phone          String
  deliveryAddress String
  area           String
  deliveryNote   String?
  subtotal       Int
  deliveryFee    Int
  discount       Int            @default(0)
  total          Int
  paymentMethod  PaymentMethod  @default(COD)
  status         OrderStatus    @default(PENDING)
  user           User           @relation(fields: [userId], references: [id])
  address        Address?       @relation(fields: [addressId], references: [id])
  items          OrderItem[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model OrderItem {
  id          String         @id @default(cuid())
  orderId     String
  variantId   String
  productName String
  variantName String
  quantity    Int
  unitPrice   Int
  subtotal    Int
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant     ProductVariant @relation(fields: [variantId], references: [id])
}

model DeliveryZone {
  id                  String  @id @default(cuid())
  nameBn              String
  fee                 Int
  minimumOrder        Int     @default(0)
  freeDeliveryAbove   Int?
  active              Boolean @default(true)
}

model Coupon {
  id             String   @id @default(cuid())
  code           String   @unique
  percentage     Int?
  fixedAmount    Int?
  minimumOrder   Int      @default(0)
  usageLimit     Int?
  usedCount      Int      @default(0)
  expiresAt      DateTime
  active         Boolean  @default(true)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  titleBn   String
  bodyBn    String
  read      Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}
